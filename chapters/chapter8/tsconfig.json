{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "sourceMap": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "test",
    "e2e",
    "vite.config.ts"
  ],
  "files": [
    "src/resource.d.ts"
  ]
}
